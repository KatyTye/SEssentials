<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>me.daivdmajholt</groupId>
    <artifactId>sessentials</artifactId>
    <packaging>jar</packaging>
    <version>0.1.1</version>
    <name>sessentials</name>

    <!-- ===================== -->
    <!-- Properties -->
    <!-- ===================== -->

    <properties>

        <!-- KEEP JAVA 17 -->
        <!-- Supports 1.19 → 1.21 safely -->
        <java.version>17</java.version>

        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven.build.timestamp.format>yyyy/MM/dd HH:mm</maven.build.timestamp.format>

    </properties>

    <!-- ===================== -->
    <!-- Dependency Management -->
    <!-- ===================== -->

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.10.1</version>
            </dependency>

            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>32.1.3-jre</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ===================== -->
    <!-- Dependencies -->
    <!-- ===================== -->

    <dependencies>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.19-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Database -->

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>

    </dependencies>

    <!-- ===================== -->
    <!-- Repositories -->
    <!-- ===================== -->

    <repositories>

        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>

    </repositories>

    <!-- ===================== -->
    <!-- Build -->
    <!-- ===================== -->

    <build>

        <!-- ===================== -->
        <!-- Resources -->
        <!-- ===================== -->

        <resources>

            <resource>
                <directory>src/main/resources</directory>

                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                    <include>spawn.yml</include>
                    <include>ranks.yml</include>
                    <include>database.db</include>
                </includes>

            </resource>

        </resources>

        <!-- ===================== -->
        <!-- Plugins -->
        <!-- ===================== -->

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <createDependencyReducedPom>false</createDependencyReducedPom>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ===================== -->
            <!-- Compiler -->
            <!-- ===================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>

                <configuration>

                    <source>${java.version}</source>
                    <target>${java.version}</target>

                </configuration>
            </plugin>

            <!-- ===================== -->
            <!-- Jar -->
            <!-- ===================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>

            <!-- ===================== -->
            <!-- Build Helper -->
            <!-- ===================== -->

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.4.0</version>

                <executions>

                    <execution>
                        <id>add-generated-source</id>
                        <phase>generate-sources</phase>

                        <goals>
                            <goal>add-source</goal>
                        </goals>

                        <configuration>

                            <sources>
                                <source>${project.build.directory}/generated-sources/buildinfo</source>
                            </sources>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

            <!-- ===================== -->
            <!-- Antrun -->
            <!-- ===================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>

                <executions>

                    <!-- Generate BuildInfo -->

                    <execution>
                        <id>generate-build-info</id>
                        <phase>generate-sources</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>

                            <target>

                                <mkdir dir="${project.build.directory}/generated-sources/buildinfo/me/daivdmajholt"/>

                                <echo file="${project.build.directory}/generated-sources/buildinfo/me/daivdmajholt/BuildInfo.java"><![CDATA[
package me.daivdmajholt;

public final class BuildInfo {

    public static final String BUILD_TIMESTAMP = "${maven.build.timestamp}";

    private BuildInfo() {}

}
]]></echo>

                            </target>

                        </configuration>

                    </execution>

                    <!-- Copy built jar -->

                    <execution>
                        <id>copy-plugin-jar</id>
                        <phase>package</phase>

                        <goals>
                            <goal>run</goal>
                        </goals>

                        <configuration>

                            <target>

                                <copy
                                        file="${project.build.directory}/${project.build.finalName}.jar"
                                        todir="/home/squirrel/Documents/Projects/Minecraft/PluginTester/plugins"
                                        overwrite="true"/>

                            </target>

                        </configuration>

                    </execution>

                </executions>

            </plugin>

        </plugins>

    </build>

</project>